---
import type { CollectionEntry } from 'astro:content';
import { uiStrings, type Locale } from '@/config/i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  locale?: Locale;
}

const { project, locale = 'fr' } = Astro.props;
const t = uiStrings[locale];
const { data } = project;
const tech = data.cardTech ?? data.technologies.slice(0, 4);
const href = `/projets/${project.slug}/`;
---

<article
  class="group relative flex flex-col rounded-xl border border-white/[0.08] bg-bg-surface/50 p-6 transition-colors duration-150 hover:border-accent-primary/40 focus-within:border-accent-primary/40"
>
  <p class="font-mono text-xs text-text-muted">{data.cardContext ?? data.projectContext}</p>

  <h3 class="mt-3 font-display text-xl font-semibold leading-snug text-text-primary">
    <!-- Lien étiré : toute la carte est cliquable, le titre reste le seul arrêt clavier vers la fiche -->
    <a href={href} class="after:absolute after:inset-0 after:rounded-xl group-hover:text-accent-primary">
      {data.cardTitle ?? data.title}
    </a>
  </h3>

  <p class="mt-3 text-sm leading-relaxed text-text-secondary">{data.summary}</p>

  {data.cardRole && <p class="mt-3 text-sm text-text-primary/80">{data.cardRole}</p>}

  <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technologies principales">
    {tech.map((item) => <li class="tech-tag">{item}</li>)}
  </ul>

  <div class="mt-auto flex items-center justify-between gap-4 pt-6">
    <span class="text-sm font-medium text-accent-primary" aria-hidden="true">
      {t.sections.readCase} →
    </span>
    {data.repositoryUrl && (
      <a
        href={data.repositoryUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="relative z-10 text-sm text-text-secondary transition-colors hover:text-text-primary"
      >
        GitHub <span aria-hidden="true">↗</span><span class="sr-only">(nouvel onglet)</span>
      </a>
    )}
  </div>
</article>
