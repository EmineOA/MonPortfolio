---
interface StepItem {
  step: string;
  title: string;
  description: string;
  tag?: string;
}

interface Props {
  steps: StepItem[];
  title?: string;
}

const { steps, title = 'Pipeline & Architecture Méthodologique' } = Astro.props;
---

<div class="tech-card my-8 p-6 sm:p-7">
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/[0.08] pb-4">
    <div class="flex items-center gap-2">
      <span class="h-2 w-2 rounded-full bg-accent-secondary" aria-hidden="true"></span>
      <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-text-primary">
        {title}
      </h3>
    </div>
    <span class="font-mono text-[11px] text-text-muted">
      SCHÉMA D’INGÉNIERIE SYSTÈME
    </span>
  </div>

  <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map((item, idx) => (
      <li class="relative flex flex-col justify-between rounded-xl border border-white/[0.07] bg-bg-primary/80 p-4">
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-accent-primary/15 font-mono text-xs font-bold text-accent-primary border border-accent-primary/30">
              {item.step}
            </span>
            {idx < steps.length - 1 && (
              <span
                class="hidden font-mono text-xs text-accent-primary/60 lg:inline-block"
                aria-hidden="true"
              >
                ───►
              </span>
            )}
          </div>

          <h4 class="mt-3 font-display text-sm font-bold text-text-primary leading-snug">
            {item.title}
          </h4>

          <p class="mt-2 text-xs leading-relaxed text-text-secondary">
            {item.description}
          </p>
        </div>

        {item.tag && (
          <div class="mt-4 border-t border-white/[0.06] pt-2.5">
            <span class="font-mono text-[10px] font-medium text-accent-secondary">
              {item.tag}
            </span>
          </div>
        )}
      </li>
    ))}
  </ol>
</div>
