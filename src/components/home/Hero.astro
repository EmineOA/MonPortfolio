---
import type { CollectionEntry } from 'astro:content';
import { profileConfig } from '@/config/profile';
import { uiStrings, type Locale } from '@/config/i18n';

interface Props {
  featured: CollectionEntry<'projects'>[];
  locale?: Locale;
}

const { featured, locale = 'fr' } = Astro.props;
const t = uiStrings[locale];
const { identity, contact } = profileConfig;
---

<section class="border-b border-white/[0.06]" aria-labelledby="hero-heading">
  <div class="mx-auto max-w-6xl px-4 pt-10 pb-14 sm:px-6 sm:pt-14 sm:pb-16 lg:px-8 lg:pt-16 lg:pb-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-10">
      <!-- Présentation -->
      <div class="lg:col-span-8">
        <p class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-bg-surface/40 px-3 py-1 text-xs text-text-secondary">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-primary" aria-hidden="true"></span>
          <span>{identity.heroBadge}</span>
        </p>

        <h1
          id="hero-heading"
          class="mt-6 font-display text-4xl font-bold tracking-tight text-text-primary sm:text-5xl lg:text-6xl"
        >
          {identity.fullName}
        </h1>

        <p class="mt-3.5 max-w-2xl font-display text-xl font-medium leading-snug text-text-primary/90 sm:text-2xl lg:text-[26px]">
          {identity.heroTitle}
        </p>

        <p class="mt-5 max-w-xl text-base leading-relaxed text-text-secondary sm:text-[17px]">
          {identity.heroIntro}
        </p>

        <!-- Repères chronologiques discrets -->
        <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-text-muted">
          <a href="#parcours" class="transition-colors hover:text-text-secondary">
            CY Tech · 2024–2027
          </a>
          <span aria-hidden="true">·</span>
          <a href="#experience" class="transition-colors hover:text-text-secondary">
            BNP Paribas CIB · 2026
          </a>
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href="#projets"
            class="inline-flex items-center gap-2 rounded-lg bg-accent-primary px-5 py-2.5 text-sm font-semibold text-bg-primary transition-colors hover:bg-accent-primary/90"
          >
            <span>{t.hero.ctaProjects}</span>
            <span aria-hidden="true">↓</span>
          </a>
          {contact.cvPdfPath.value && (
            <a
              href={contact.cvPdfPath.value}
              download
              class="inline-flex items-center gap-2 rounded-lg border border-white/15 px-5 py-2.5 text-sm font-medium text-text-primary transition-colors hover:border-accent-primary/60"
            >
              <span>{t.hero.ctaCv}</span>
            </a>
          )}
        </div>

        <ul class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
          {contact.githubUrl.value && (
            <li>
              <a href={contact.githubUrl.value} target="_blank" rel="noopener noreferrer" class="text-link">
                GitHub <span aria-hidden="true">↗</span><span class="sr-only">(nouvel onglet)</span>
              </a>
            </li>
          )}
          <li>
            <a href={contact.linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-link">
              LinkedIn <span aria-hidden="true">↗</span><span class="sr-only">(nouvel onglet)</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Accès direct aux projets sélectionnés (desktop), aligné sur le titre principal -->
      <nav class="hidden lg:col-span-4 lg:block lg:pt-[52px]" aria-label={t.hero.featuredLabel}>
        <p class="font-mono text-xs uppercase tracking-wider text-text-muted">
          {t.hero.featuredLabel}
        </p>
        <ol class="mt-3 divide-y divide-white/[0.06] border-y border-white/[0.06]">
          {featured.map((project, index) => (
            <li>
              <a
                href={`/projets/${project.slug}/`}
                class="group -mx-3 my-0.5 flex items-baseline gap-3.5 rounded-lg px-3 py-3.5 transition-colors duration-150 hover:bg-white/[0.035] focus-visible:bg-white/[0.035]"
              >
                <span class="font-mono text-xs text-text-muted transition-colors group-hover:text-accent-primary group-focus-visible:text-accent-primary">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-sm font-medium text-text-primary transition-colors group-hover:text-accent-primary group-focus-visible:text-accent-primary">
                    {project.data.cardTitle ?? project.data.title}
                  </span>
                  <span class="mt-0.5 block text-xs text-text-muted">
                    {project.data.domain}
                  </span>
                </span>
                <span
                  class="text-text-muted transition-transform duration-150 group-hover:translate-x-0.5 group-hover:text-accent-primary group-focus-visible:translate-x-0.5 group-focus-visible:text-accent-primary"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>
            </li>
          ))}
        </ol>
        <a href="/projets/" class="text-link mt-3.5">
          <span>{t.hero.allProjects}</span>
          <span aria-hidden="true">→</span>
        </a>
      </nav>
    </div>
  </div>
</section>
