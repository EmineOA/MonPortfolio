---
import { profileConfig } from '@/config/profile';
import { uiStrings, type Locale } from '@/config/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const t = uiStrings[locale];
const { identity, contact, domains } = profileConfig;
---

<section
  class="relative overflow-hidden border-b border-white/[0.07] bg-radial-tech pt-12 pb-20 sm:pt-16 sm:pb-24 lg:pt-20 lg:pb-28"
  aria-labelledby="hero-heading"
>
  <!-- Subtle scientific grid backdrop -->
  <div
    class="pointer-events-none absolute inset-0 bg-grid-pattern bg-[size:48px_48px] opacity-60 [mask-image:radial-gradient(ellipse_at_top,black_45%,transparent_85%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <!-- Left column: Main Identity & Value Proposition (7 cols) -->
      <div class="lg:col-span-7">
        <!-- Internship Search Badge -->
        <div
          class="inline-flex items-center gap-2.5 rounded-full border border-accent-secondary/35 bg-bg-elevated/90 px-3.5 py-1.5 shadow-sm"
        >
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-secondary opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent-secondary"></span>
          </span>
          <span class="font-mono text-xs font-medium tracking-wide text-text-primary">
            {identity.statusBadge}
          </span>
        </div>

        <!-- Name & Title -->
        <h1
          id="hero-heading"
          class="mt-6 font-display text-4xl font-bold tracking-tight text-text-primary sm:text-5xl lg:text-6xl"
        >
          {identity.fullName}
        </h1>

        <p
          class="mt-3 font-display text-lg font-semibold text-accent-primary sm:text-xl lg:text-2xl"
        >
          {identity.headline}
        </p>

        <!-- Proposed summary text -->
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-text-secondary sm:text-lg">
          {identity.subheadline}
        </p>

        <!-- Primary CTAs & Verified Links -->
        <div class="mt-8 flex flex-wrap items-center gap-3.5">
          <a
            href="#projets"
            class="inline-flex items-center gap-2 rounded-lg bg-accent-primary px-5 py-3 text-sm font-semibold text-bg-primary shadow-sm transition-all hover:bg-accent-primary/90"
          >
            <span>{t.hero.ctaProjects}</span>
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                clip-rule="evenodd"></path>
            </svg>
          </a>

          {contact.cvPdfPath.value && (
            <a
              href={contact.cvPdfPath.value}
              download
              class="inline-flex items-center gap-2 rounded-lg border border-accent-secondary/45 bg-bg-elevated px-5 py-3 text-sm font-semibold text-text-primary transition-colors hover:border-accent-secondary hover:bg-bg-surface"
            >
              <svg class="h-4 w-4 text-accent-secondary" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>{t.hero.ctaCv}</span>
            </a>
          )}

          <a
            href={contact.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-white/[0.12] bg-bg-surface px-4 py-3 text-sm font-medium text-text-primary transition-colors hover:border-accent-primary/50 hover:bg-bg-elevated"
          >
            <svg class="h-4 w-4 text-accent-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
            </svg>
            <span>LinkedIn</span>
            <span class="font-mono text-xs text-text-muted" aria-hidden="true">↗</span>
          </a>

          {contact.githubUrl.value && (
            <a
              href={contact.githubUrl.value}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg border border-white/[0.12] bg-bg-surface px-4 py-3 text-sm font-medium text-text-primary transition-colors hover:border-accent-primary/50 hover:bg-bg-elevated"
            >
              <span>GitHub</span>
              <span class="font-mono text-xs text-text-muted" aria-hidden="true">↗</span>
            </a>
          )}
        </div>

        <!-- Recruiter Quick-Scan Strip -->
        <div
          class="mt-10 grid grid-cols-2 gap-3 border-t border-white/[0.08] pt-6 sm:grid-cols-4"
        >
          <div class="rounded-lg border border-white/[0.06] bg-bg-surface/70 p-3">
            <span class="block font-mono text-[11px] uppercase tracking-wider text-text-muted">
              Formation
            </span>
            <span class="mt-1 block font-display text-sm font-semibold text-text-primary">
              CY Tech (2024–2027)
            </span>
          </div>

          <div class="rounded-lg border border-accent-primary/25 bg-bg-surface/90 p-3">
            <span class="block font-mono text-[11px] uppercase tracking-wider text-accent-primary">
              Distinction
            </span>
            <span class="mt-1 block font-display text-sm font-semibold text-text-primary">
              Top 2 de promotion
            </span>
          </div>

          <div class="rounded-lg border border-white/[0.06] bg-bg-surface/70 p-3">
            <span class="block font-mono text-[11px] uppercase tracking-wider text-text-muted">
              Expérience
            </span>
            <span class="mt-1 block font-display text-sm font-semibold text-text-primary">
              BNP Paribas CIB
            </span>
          </div>

          <div class="rounded-lg border border-white/[0.06] bg-bg-surface/70 p-3">
            <span class="block font-mono text-[11px] uppercase tracking-wider text-text-muted">
              Certifications
            </span>
            <span class="mt-1 block font-display text-sm font-semibold text-text-primary">
              5 Certifications IBM
            </span>
          </div>
        </div>
      </div>

      <!-- Right column: Abstract Scientific / Neural Topology Panel (5 cols) -->
      <div class="lg:col-span-5">
        <div class="tech-card relative overflow-hidden p-5 sm:p-6">
          <div class="flex items-center justify-between border-b border-white/[0.07] pb-3.5">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-accent-primary"></span>
              <span class="font-mono text-xs font-medium text-text-primary">
                PROFIL D’INGÉNIERIE // SYNTHÈSE
              </span>
            </div>
            <span class="font-mono text-[11px] text-accent-secondary">
              MATHS APPLIQUÉES &amp; IA
            </span>
          </div>

          <!-- Subtle Scientific Visualization SVG (Neural Network + Spectral Waveform) -->
          <div
            class="my-4 rounded-lg border border-white/[0.06] bg-bg-primary/90 p-4"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 420 175"
              class="w-full h-auto"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <!-- Subtle coordinate grid -->
              <g stroke="#F5F7FA" stroke-opacity="0.05" stroke-width="1">
                <line x1="0" y1="35" x2="420" y2="35" />
                <line x1="0" y1="70" x2="420" y2="70" />
                <line x1="0" y1="105" x2="420" y2="105" />
                <line x1="0" y1="140" x2="420" y2="140" />
                <line x1="84" y1="0" x2="84" y2="175" />
                <line x1="168" y1="0" x2="168" y2="175" />
                <line x1="252" y1="0" x2="252" y2="175" />
                <line x1="336" y1="0" x2="336" y2="175" />
              </g>

              <!-- Network edges -->
              <g stroke="#60A5FA" stroke-opacity="0.26" stroke-width="1.2">
                <line x1="48" y1="38" x2="148" y2="28" />
                <line x1="48" y1="38" x2="148" y2="68" />
                <line x1="48" y1="38" x2="148" y2="108" />
                <line x1="48" y1="88" x2="148" y2="28" />
                <line x1="48" y1="88" x2="148" y2="68" />
                <line x1="48" y1="88" x2="148" y2="108" />
                <line x1="48" y1="88" x2="148" y2="146" />
                <line x1="48" y1="138" x2="148" y2="68" />
                <line x1="48" y1="138" x2="148" y2="108" />
                <line x1="48" y1="138" x2="148" y2="146" />

                <line x1="148" y1="28" x2="258" y2="48" />
                <line x1="148" y1="28" x2="258" y2="88" />
                <line x1="148" y1="68" x2="258" y2="48" />
                <line x1="148" y1="68" x2="258" y2="88" />
                <line x1="148" y1="68" x2="258" y2="128" />
                <line x1="148" y1="108" x2="258" y2="48" />
                <line x1="148" y1="108" x2="258" y2="88" />
                <line x1="148" y1="108" x2="258" y2="128" />
                <line x1="148" y1="146" x2="258" y2="88" />
                <line x1="148" y1="146" x2="258" y2="128" />
              </g>

              <!-- Highlighted active path -->
              <g stroke="#22D3EE" stroke-opacity="0.65" stroke-width="1.6">
                <line x1="48" y1="88" x2="148" y2="68" />
                <line x1="148" y1="68" x2="258" y2="88" />
                <line x1="258" y1="88" x2="368" y2="62" />
                <line x1="258" y1="128" x2="368" y2="114" />
              </g>

              <!-- Spectral / distribution curve on the right -->
              <path
                d="M270 145 C 295 142, 305 60, 330 58 C 355 56, 365 120, 398 112"
                stroke="#60A5FA"
                stroke-width="2"
                fill="none"
              />
              <path
                d="M270 150 C 300 148, 318 92, 345 90 C 370 88, 382 135, 398 132"
                stroke="#22D3EE"
                stroke-width="1.5"
                stroke-dasharray="3 3"
                fill="none"
              />

              <!-- Layer nodes -->
              <g fill="#111827" stroke="#60A5FA" stroke-width="2">
                <circle cx="48" cy="38" r="5" />
                <circle cx="48" cy="88" r="5" stroke="#22D3EE" />
                <circle cx="48" cy="138" r="5" />

                <circle cx="148" cy="28" r="5" />
                <circle cx="148" cy="68" r="5.5" fill="#22D3EE" stroke="#22D3EE" />
                <circle cx="148" cy="108" r="5" />
                <circle cx="148" cy="146" r="5" />

                <circle cx="258" cy="48" r="5" />
                <circle cx="258" cy="88" r="5.5" fill="#60A5FA" stroke="#60A5FA" />
                <circle cx="258" cy="128" r="5" stroke="#22D3EE" />

                <circle cx="368" cy="62" r="6" fill="#22D3EE" stroke="#22D3EE" />
                <circle cx="368" cy="114" r="5" />
              </g>

              <!-- Technical labels -->
              <text x="24" y="166" fill="#718096" font-family="JetBrains Mono, monospace" font-size="9">
                INPUT TENSORS
              </text>
              <text x="122" y="166" fill="#718096" font-family="JetBrains Mono, monospace" font-size="9">
                LATENT SPACE
              </text>
              <text x="292" y="24" fill="#60A5FA" font-family="JetBrains Mono, monospace" font-size="9">
                MODÉLISATION &amp; INFÉRENCE
              </text>
            </svg>
          </div>

          <!-- Core Engineering Domains List -->
          <div class="space-y-2">
            <p class="font-mono text-[11px] uppercase tracking-wider text-text-muted">
              Domaines d’intervention documentés
            </p>
            <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2">
              {domains.map((domain, idx) => (
                <li class="flex items-start gap-2 rounded-lg border border-white/[0.05] bg-bg-elevated/55 px-3 py-2">
                  <span class="font-mono text-xs font-semibold text-accent-primary">
                    0{idx + 1}
                  </span>
                  <span class="text-xs font-medium text-text-primary leading-snug">
                    {domain.title}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
