---
import { profileConfig } from '@/config/profile';

const { identity, contact } = profileConfig;
---

<footer class="border-t border-white/[0.06]">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 text-sm text-text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
  >
    <p>© {new Date().getFullYear()} {identity.fullName} · CY Tech, mathématiques appliquées &amp; IA</p>
    <ul class="flex items-center gap-5">
      <li><a href="/projets/" class="transition-colors hover:text-text-primary">Projets</a></li>
      {contact.githubUrl.value && (
        <li>
          <a href={contact.githubUrl.value} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-text-primary">
            GitHub
          </a>
        </li>
      )}
      <li>
        <a href={contact.linkedinUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-text-primary">
          LinkedIn
        </a>
      </li>
    </ul>
  </div>
</footer>
