---
import { profileConfig } from '@/config/profile';
import { uiStrings, type Locale } from '@/config/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const t = uiStrings[locale];
const { contact } = profileConfig;
---

<header
  class="sticky top-0 z-50 w-full border-b border-white/[0.07] bg-bg-primary/85 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand / Identity -->
    <a
      href={locale === 'en' ? '/en' : '/'}
      class="group flex items-center gap-3 focus-visible:outline-none"
      aria-label="Emine AGATT — Retour à l'accueil"
    >
      <span
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-accent-primary/35 bg-bg-surface font-mono text-sm font-semibold text-accent-primary transition-colors group-hover:border-accent-primary group-hover:bg-bg-elevated"
      >
        EA
      </span>
      <div class="flex flex-col">
        <span class="font-display text-sm font-bold tracking-tight text-text-primary sm:text-base">
          Emine AGATT
        </span>
        <span class="hidden font-mono text-[11px] text-text-secondary sm:inline-block">
          CY Tech • Mathématiques Appliquées &amp; IA
        </span>
      </div>
    </a>

    <!-- Primary Navigation -->
    <nav aria-label="Navigation principale" class="hidden md:flex md:items-center md:gap-7">
      <a
        href="/#projets"
        class="text-sm font-medium text-text-secondary transition-colors hover:text-text-primary"
      >
        {t.nav.projects}
      </a>
      <a
        href="/#parcours"
        class="text-sm font-medium text-text-secondary transition-colors hover:text-text-primary"
      >
        {t.nav.experience}
      </a>
      <a
        href="/#competences"
        class="text-sm font-medium text-text-secondary transition-colors hover:text-text-primary"
      >
        {t.nav.skills}
      </a>
      <a
        href="/#contact"
        class="text-sm font-medium text-text-secondary transition-colors hover:text-text-primary"
      >
        {t.nav.contact}
      </a>
    </nav>

    <!-- Actions & External Verified Links -->
    <div class="flex items-center gap-2.5 sm:gap-3">
      <a
        href={contact.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-lg border border-white/[0.1] bg-bg-surface px-3 py-1.5 font-mono text-xs font-medium text-text-primary transition-colors hover:border-accent-primary/50 hover:bg-bg-elevated"
        aria-label="Profil LinkedIn d'Emine AGATT (nouvel onglet)"
      >
        <svg class="h-3.5 w-3.5 text-accent-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
        </svg>
        <span>LinkedIn</span>
      </a>

      {contact.githubUrl.value && (
        <a
          href={contact.githubUrl.value}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg border border-white/[0.1] bg-bg-surface px-3 py-1.5 font-mono text-xs font-medium text-text-primary transition-colors hover:border-accent-primary/50 hover:bg-bg-elevated"
          aria-label="Profil GitHub d'Emine AGATT (nouvel onglet)"
        >
          <span>GitHub</span>
        </a>
      )}

      <a
        href="/#contact"
        class="inline-flex items-center rounded-lg bg-accent-primary/15 border border-accent-primary/40 px-3.5 py-1.5 text-xs font-semibold text-accent-primary transition-colors hover:bg-accent-primary hover:text-bg-primary"
      >
        {t.nav.contact}
      </a>
    </div>
  </div>

  <!-- Mobile compact sub-navigation -->
  <nav
    aria-label="Navigation mobile"
    class="flex items-center justify-around border-t border-white/[0.06] bg-bg-surface/70 py-2 px-2 text-xs font-medium text-text-secondary md:hidden"
  >
    <a href="/#projets" class="px-2 py-1 hover:text-text-primary">{t.nav.projects}</a>
    <a href="/#parcours" class="px-2 py-1 hover:text-text-primary">{t.nav.experience}</a>
    <a href="/#competences" class="px-2 py-1 hover:text-text-primary">{t.nav.skills}</a>
    <a href="/#contact" class="px-2 py-1 hover:text-text-primary">{t.nav.contact}</a>
  </nav>
</header>
