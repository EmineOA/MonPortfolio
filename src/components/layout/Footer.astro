---
import { profileConfig } from '@/config/profile';

const { identity, education, contact, languages } = profileConfig;
---

<footer class="border-t border-white/[0.08] bg-bg-subtle">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-3">
      <!-- Column 1: Identity -->
      <div>
        <div class="flex items-center gap-2.5">
          <span
            class="flex h-7 w-7 items-center justify-center rounded-md border border-accent-primary/40 bg-bg-surface font-mono text-xs font-semibold text-accent-primary"
          >
            EA
          </span>
          <span class="font-display text-base font-bold text-text-primary">
            {identity.fullName}
          </span>
        </div>
        <p class="mt-3 text-sm text-text-secondary leading-relaxed">
          {identity.headline}
        </p>
        <p class="mt-2 font-mono text-xs text-text-muted">
          {education.institution} ({education.period})
        </p>
      </div>

      <!-- Column 2: Quick Navigation -->
      <div>
        <h2 class="font-mono text-xs font-semibold uppercase tracking-wider text-text-primary">
          Navigation
        </h2>
        <ul class="mt-3 space-y-2 text-sm text-text-secondary">
          <li>
            <a href="/#projets" class="transition-colors hover:text-accent-primary">
              Projets sélectionnés (5 études de cas)
            </a>
          </li>
          <li>
            <a href="/#parcours" class="transition-colors hover:text-accent-primary">
              Parcours, distinctions &amp; certifications IBM
            </a>
          </li>
          <li>
            <a href="/#competences" class="transition-colors hover:text-accent-primary">
              Compétences par domaine
            </a>
          </li>
          <li>
            <a href="/#contact" class="transition-colors hover:text-accent-primary">
              Contact &amp; stage de fin d’études
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Profile metadata -->
      <div>
        <h2 class="font-mono text-xs font-semibold uppercase tracking-wider text-text-primary">
          Informations clés
        </h2>
        <ul class="mt-3 space-y-2 text-sm text-text-secondary">
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-accent-secondary"></span>
            <span>{identity.statusBadge}</span>
          </li>
          <li>
            <span class="text-text-muted">Langues :</span>{' '}
            {languages.map((l) => l.name).join(' • ')}
          </li>
          <li>
            <a
              href={contact.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-accent-primary hover:underline"
            >
              <span>LinkedIn : linkedin.com/in/emine-agatt</span>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col items-start justify-between gap-4 border-t border-white/[0.06] pt-6 text-xs text-text-muted sm:flex-row sm:items-center"
    >
      <p>
        © {new Date().getFullYear()} {identity.fullName}. Conçu et développé avec Astro &amp; Tailwind CSS.
      </p>
      <p class="font-mono">
        Mathématiques Appliquées • Data Science • Machine Learning • Ingénierie Logicielle
      </p>
    </div>
  </div>
</footer>
