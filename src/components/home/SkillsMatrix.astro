---
import { profileConfig } from '@/config/profile';
import { uiStrings, type Locale } from '@/config/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const t = uiStrings[locale];
const { skillsByDomain } = profileConfig;
---

<section
  id="competences"
  class="scroll-mt-20 border-b border-white/[0.07] py-20 sm:py-24"
  aria-labelledby="skills-heading"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-3xl">
      <span class="section-eyebrow">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-primary"></span>
        <span>{t.sections.skillsEyebrow}</span>
      </span>
      <h2 id="skills-heading" class="mt-3 section-heading">
        {t.sections.skillsTitle}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-text-secondary">
        Technologies, méthodes mathématiques et outils d’ingénierie mobilisés dans les projets académiques, expérimentaux et applicatifs documentés.
      </p>
    </div>

    <!-- 5 Domains Grid -->
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {skillsByDomain.map((domain, idx) => (
        <div
          class:list={[
            'tech-card flex flex-col justify-between p-6',
            idx === 0 ? 'lg:col-span-2 border-accent-primary/25' : '',
          ]}
        >
          <div>
            <div class="flex items-center justify-between gap-2 border-b border-white/[0.07] pb-3">
              <span class="font-mono text-xs font-semibold text-accent-primary">
                {domain.code}
              </span>
              <span class="font-mono text-[11px] text-text-muted">
                {domain.skills.length} COMPÉTENCES DOCUMENTÉES
              </span>
            </div>

            <h3 class="mt-4 font-display text-lg font-bold text-text-primary sm:text-xl">
              {domain.title}
            </h3>

            <p class="mt-2 text-sm leading-relaxed text-text-secondary">
              {domain.description}
            </p>
          </div>

          <ul
            class="mt-5 flex flex-wrap gap-2 pt-2"
            aria-label={`Compétences du domaine ${domain.title}`}
          >
            {domain.skills.map((skill) => (
              <li class="tech-badge">{skill}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
