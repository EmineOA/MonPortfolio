---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profileConfig } from '@/config/profile';

// Contenu détaillé du stage, auparavant affiché dans la section Parcours de la homepage.
const exp = profileConfig.experience.find((e) => e.id === 'bnp-paribas-cib')!;
const projects = exp.projects ?? [];
---

<BaseLayout
  title="BNP Paribas CIB — Stage Data Science & Data Engineering (AML IT) | Emine AGATT"
  description={exp.summary}
  canonicalPath="/experience/bnp-paribas-cib/"
>
  <!-- En-tête -->
  <section class="border-b border-white/[0.06] pb-14 pt-10 sm:pb-16 sm:pt-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Fil d'Ariane" class="flex items-center gap-2 font-mono text-xs text-text-secondary">
        <a href="/" class="transition-colors hover:text-accent-primary">Accueil</a>
        <span aria-hidden="true">/</span>
        <a href="/#experience" class="transition-colors hover:text-accent-primary">Expérience</a>
        <span aria-hidden="true">/</span>
        <span class="text-accent-primary">BNP Paribas CIB</span>
      </nav>

      <p class="mt-8 font-mono text-xs text-text-muted">Expérience professionnelle · stage</p>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-text-primary sm:text-5xl">{exp.company}</h1>
      <p class="mt-3 font-display text-xl font-medium text-accent-primary sm:text-2xl">{exp.role.value}</p>

      <dl class="mt-8 grid max-w-3xl gap-x-10 gap-y-4 text-sm sm:grid-cols-2">
        <div>
          <dt class="text-text-muted">Période</dt>
          <dd class="mt-1 text-text-primary">{exp.exactDates} ({exp.duration})</dd>
        </div>
        <div>
          <dt class="text-text-muted">Lieu</dt>
          <dd class="mt-1 text-text-primary">{exp.location}</dd>
        </div>
        <div>
          <dt class="text-text-muted">Équipe</dt>
          <dd class="mt-1 text-text-primary">{exp.team}</dd>
        </div>
        <div>
          <dt class="text-text-muted">Intitulé contractuel</dt>
          <dd class="mt-1 text-text-primary">{exp.contractualTitle}</dd>
        </div>
      </dl>

      <p class="mt-8 max-w-3xl text-base leading-relaxed text-text-secondary sm:text-lg">{exp.summary}</p>
    </div>
  </section>

  <!-- Missions et technologies -->
  <section class="border-b border-white/[0.06] py-14">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <div class="lg:col-span-7">
        <h2 class="font-display text-2xl font-semibold text-text-primary">Missions</h2>
        <ul class="mt-5 space-y-3 text-sm leading-relaxed text-text-secondary sm:text-base">
          {exp.missions.value?.map((mission) => (
            <li class="flex gap-3">
              <span class="mt-0.5 font-mono text-xs text-accent-primary" aria-hidden="true">▹</span>
              <span>{mission}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-5">
        <h2 class="font-display text-2xl font-semibold text-text-primary">Technologies</h2>
        <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technologies utilisées">
          {exp.mainTechnologies?.map((tech) => <li class="tech-badge">{tech}</li>)}
        </ul>
        <p class="mt-6 text-sm leading-relaxed text-text-muted">
          Le code a été développé dans l’environnement interne de BNP Paribas : aucun dépôt ni démonstration publique
          n’est associé à cette expérience.
        </p>
      </div>
    </div>
  </section>

  <!-- Projets réalisés pendant le stage -->
  <section class="py-14 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-semibold tracking-tight text-text-primary">Projets réalisés pendant le stage</h2>
      <p class="section-lead mt-3">
        Le projet Entity Resolution Evaluation constitue mon principal travail individuel ; la modélisation ISO 20022 a
        été menée en binôme.
      </p>

      <div class="mt-10 space-y-10">
        {projects.map((proj) => (
          <article class:list={['tech-card p-6 sm:p-8 lg:p-10', proj.priority && 'border-accent-primary/35']}>
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/[0.08] pb-5">
              <span class="rounded bg-accent-primary/15 px-2.5 py-1 font-mono text-xs font-semibold text-accent-primary">
                {proj.code}
              </span>
              <span class="font-mono text-xs text-text-secondary">{proj.workModeBadge}</span>
            </div>

            <h3 class="mt-6 font-display text-2xl font-bold text-text-primary sm:text-3xl">{proj.title}</h3>
            <p class="mt-2 text-base text-text-secondary">{proj.subtitle}</p>

            <div class="mt-8 grid gap-8 lg:grid-cols-2">
              <div>
                <h4 class="text-sm font-medium text-accent-primary">Contexte</h4>
                <p class="mt-2 text-sm leading-relaxed text-text-secondary">{proj.context}</p>
              </div>
              <div>
                <h4 class="text-sm font-medium text-accent-primary">Objectif</h4>
                <p class="mt-2 text-sm leading-relaxed text-text-secondary">{proj.objective}</p>
              </div>
            </div>

            {proj.metrics && proj.metrics.length > 0 && (
              <div class="mt-8">
                <h4 class="text-sm font-medium text-text-primary">Résultats quantitatifs du projet (travail en binôme)</h4>
                <dl class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                  {proj.metrics.map((metric) => (
                    <div class="rounded-lg border border-white/[0.07] bg-bg-primary/60 p-4">
                      <dt class="font-mono text-xs text-text-secondary">{metric.label}</dt>
                      <dd class="mt-1 font-mono text-xl font-bold text-accent-primary">{metric.value}</dd>
                      <p class="mt-1 text-xs leading-snug text-text-muted">{metric.detail}</p>
                    </div>
                  ))}
                </dl>
              </div>
            )}

            <div class="mt-8 grid gap-x-10 gap-y-8 md:grid-cols-2">
              {proj.sections.map((sec) => (
                <div>
                  <h4 class="font-display text-base font-semibold text-text-primary">{sec.title}</h4>
                  <ul class="mt-3 space-y-2 text-sm leading-relaxed text-text-secondary">
                    {sec.items.map((item) => (
                      <li class="flex gap-2">
                        <span class="mt-0.5 font-mono text-xs text-accent-primary" aria-hidden="true">▹</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>

            <div class="mt-8 grid gap-8 border-t border-white/[0.08] pt-6 lg:grid-cols-12">
              <div class="lg:col-span-7">
                <h4 class="text-sm font-medium text-text-primary">Livrables et résultats</h4>
                <ul class="mt-3 space-y-2 text-sm leading-relaxed text-text-secondary">
                  {proj.deliverablesAndResults.map((res) => (
                    <li class="flex gap-2">
                      <span class="mt-0.5 text-accent-primary" aria-hidden="true">✓</span>
                      <span>{res}</span>
                    </li>
                  ))}
                </ul>
                <p class="mt-4 text-xs leading-relaxed text-text-muted">{proj.statusNote}</p>
              </div>
              <div class="lg:col-span-5">
                <h4 class="text-sm font-medium text-text-primary">Technologies</h4>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {proj.technologies.map((tech) => <li class="tech-badge">{tech}</li>)}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>

      <a href="/#experience" class="text-link mt-12">
        <span aria-hidden="true">←</span> Retour à l’accueil
      </a>
    </div>
  </section>
</BaseLayout>
