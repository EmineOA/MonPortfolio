---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArchitectureDiagram from '@/components/mdx/ArchitectureDiagram.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  prevProject?: CollectionEntry<'projects'> | null;
  nextProject?: CollectionEntry<'projects'> | null;
}

const { project, prevProject = null, nextProject = null } = Astro.props;
const { data } = project;
---

<BaseLayout
  title={`${data.title} — Étude de cas | Emine AGATT`}
  description={data.summary}
  canonicalPath={`/projets/${project.slug}/`}
>
  <!-- A. En-tête harmonisé de l'étude de cas -->
  <section class="relative border-b border-white/[0.08] bg-radial-tech pt-10 pb-14 sm:pt-14 sm:pb-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <!-- Fil d'Ariane -->
      <nav aria-label="Fil d'Ariane" class="flex items-center gap-2 font-mono text-xs text-text-secondary">
        <a href="/" class="hover:text-accent-primary transition-colors">Accueil</a>
        <span aria-hidden="true">/</span>
        <a href="/#projets" class="hover:text-accent-primary transition-colors">Projets</a>
        <span aria-hidden="true">/</span>
        <span class="text-accent-primary">{data.code}</span>
      </nav>

      <!-- Badges de métadonnées : Code, Domaine, Contexte & Mode de travail -->
      <div class="mt-6 flex flex-wrap items-center gap-2.5">
        <span class="rounded bg-accent-primary/15 px-2.5 py-1 font-mono text-xs font-semibold text-accent-primary border border-accent-primary/30">
          {data.code}
        </span>
        <span class="rounded bg-bg-elevated px-2.5 py-1 font-mono text-xs text-accent-secondary border border-white/[0.07]">
          {data.domain}
        </span>
        <span class="rounded bg-bg-surface px-2.5 py-1 font-mono text-xs text-text-secondary border border-white/[0.08]">
          {data.projectContext}
        </span>
        <span class="rounded bg-bg-surface px-2.5 py-1 font-mono text-xs text-text-primary border border-white/[0.08]">
          {data.workMode}
        </span>
      </div>

      <!-- Titre & Résumé -->
      <h1 class="mt-4 max-w-4xl font-display text-3xl font-bold tracking-tight text-text-primary sm:text-4xl lg:text-5xl">
        {data.title}
      </h1>

      <p class="mt-4 max-w-3xl text-base leading-relaxed text-text-secondary sm:text-lg">
        {data.summary}
      </p>

      <!-- Encadré synthétique : Mon rôle + Liens directs (si disponibles) -->
      <div class="mt-6 flex flex-col justify-between gap-4 rounded-xl border border-white/[0.08] bg-bg-surface/85 p-4 sm:flex-row sm:items-center sm:p-5">
        <div>
          <span class="block font-mono text-[11px] uppercase tracking-wider text-accent-primary">
            Mon périmètre &amp; rôle personnel
          </span>
          <p class="mt-1 text-sm font-medium text-text-primary">
            {data.myRoleSummary}
          </p>
        </div>

        {(data.repositoryUrl || data.demoUrl) && (
          <div class="flex shrink-0 flex-wrap items-center gap-2.5">
            {data.repositoryUrl && (
              <a
                href={data.repositoryUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-lg bg-accent-primary px-4 py-2 font-mono text-xs font-semibold text-bg-primary transition-all hover:bg-accent-primary/90"
              >
                <span>Code source (GitHub)</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
            {data.demoUrl && (
              <a
                href={data.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-lg border border-accent-secondary/40 bg-bg-elevated px-4 py-2 font-mono text-xs font-semibold text-accent-secondary transition-colors hover:border-accent-secondary"
              >
                <span>Démonstration</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        )}
      </div>

      <!-- Badges des technologies principales -->
      <div class="mt-6 flex flex-wrap gap-2" aria-label="Technologies principales">
        {data.technologies.map((tech) => (
          <span class="tech-badge">{tech}</span>
        ))}
      </div>

      <!-- Barre de repères & métriques contextualisées -->
      {data.metrics && data.metrics.length > 0 && (
        <dl class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {data.metrics.map((metric) => (
            <div class="tech-card p-4">
              <dt class="font-mono text-xs text-text-secondary">{metric.label}</dt>
              <dd class="mt-1.5 font-mono text-xl font-bold text-accent-primary">
                {metric.value}
              </dd>
              {metric.detail && (
                <p class="mt-1 text-xs leading-snug text-text-muted">{metric.detail}</p>
              )}
            </div>
          ))}
        </dl>
      )}
    </div>
  </section>

  <!-- Corps de l'étude de cas & Schéma de pipeline -->
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <!-- Schéma technique réutilisable -->
      <ArchitectureDiagram
        steps={data.architectureSteps}
        title={`Schéma technique — ${data.shortTitle}`}
      />

      <div class="mt-10 grid gap-10 lg:grid-cols-12">
        <!-- Colonne gauche : Sommaire harmonisé & Métadonnées (4 cols) -->
        <aside class="lg:col-span-4 space-y-6">
          <div class="tech-card sticky top-24 p-6">
            <h2 class="font-mono text-xs font-semibold uppercase tracking-wider text-text-primary">
              Structure de la fiche
            </h2>
            <ol class="mt-4 space-y-2 text-xs font-mono text-text-secondary">
              <li>1. Contexte et problématique</li>
              <li>2. Mon rôle et mes contributions</li>
              <li>3. Approche technique et architecture</li>
              <li>4. Réalisation et expérimentations</li>
              <li>5. Résultats et limites</li>
              <li>6. Technologies</li>
              <li>7. Liens et ressources</li>
            </ol>

            <div class="mt-6 border-t border-white/[0.08] pt-5">
              <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-text-primary">
                Cadre de réalisation
              </h3>
              <dl class="mt-3 space-y-2 text-xs">
                <div class="flex justify-between gap-2">
                  <dt class="text-text-muted">Contexte :</dt>
                  <dd class="font-mono text-text-primary text-right">{data.projectContext}</dd>
                </div>
                <div class="flex justify-between gap-2">
                  <dt class="text-text-muted">Organisation :</dt>
                  <dd class="font-mono text-text-primary text-right">{data.workMode}</dd>
                </div>
              </dl>
            </div>

            <div class="mt-6 border-t border-white/[0.08] pt-5">
              <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-text-primary">
                Code source &amp; Accès
              </h3>
              {data.repositoryUrl || data.demoUrl ? (
                <div class="mt-3 flex flex-col gap-2">
                  {data.repositoryUrl && (
                    <a
                      href={data.repositoryUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-between rounded-lg border border-accent-primary/40 bg-accent-primary/10 px-3.5 py-2 font-mono text-xs font-semibold text-accent-primary hover:bg-accent-primary hover:text-bg-primary transition-colors"
                    >
                      <span>Consulter le dépôt GitHub</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                  {data.demoUrl && (
                    <a
                      href={data.demoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-between rounded-lg border border-accent-secondary/40 bg-bg-elevated px-3.5 py-2 font-mono text-xs font-semibold text-accent-secondary"
                    >
                      <span>Accéder à la démonstration</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                  <p class="mt-1 text-[11px] leading-relaxed text-text-muted">
                    {data.repositoryStatusNote}
                  </p>
                </div>
              ) : (
                <p class="mt-2 text-xs leading-relaxed text-text-secondary">
                  {data.repositoryStatusNote}
                </p>
              )}
            </div>

            <div class="mt-6 border-t border-white/[0.08] pt-5">
              <a
                href="/#projets"
                class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-accent-primary hover:underline"
              >
                <span aria-hidden="true">←</span>
                <span>Retour aux projets sélectionnés</span>
              </a>
            </div>
          </div>
        </aside>

        <!-- Colonne droite : Contenu MDX harmonisé (8 cols) -->
        <article class="lg:col-span-8 tech-card p-6 sm:p-8 lg:p-10 prose-tech">
          <slot />
        </article>
      </div>

      <!-- Navigation Précédent / Suivant -->
      <nav
        aria-label="Navigation entre les projets"
        class="mt-12 grid gap-4 border-t border-white/[0.08] pt-8 sm:grid-cols-2"
      >
        {prevProject ? (
          <a
            href={`/projets/${prevProject.slug}/`}
            class="tech-card-interactive flex flex-col justify-between p-5"
          >
            <span class="font-mono text-xs text-text-muted">← Projet précédent ({prevProject.data.code})</span>
            <span class="mt-2 font-display text-base font-bold text-text-primary">
              {prevProject.data.title}
            </span>
          </a>
        ) : (
          <div />
        )}

        {nextProject && (
          <a
            href={`/projets/${nextProject.slug}/`}
            class="tech-card-interactive flex flex-col justify-between p-5 sm:text-right"
          >
            <span class="font-mono text-xs text-text-muted">Projet suivant ({nextProject.data.code}) →</span>
            <span class="mt-2 font-display text-base font-bold text-text-primary">
              {nextProject.data.title}
            </span>
          </a>
        )}
      </nav>
    </div>
  </section>
</BaseLayout>
