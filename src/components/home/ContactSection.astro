---
import { profileConfig } from '@/config/profile';
import { uiStrings, type Locale } from '@/config/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const t = uiStrings[locale];
const { contact } = profileConfig;

// Les champs non renseignés dans profile.ts sont simplement masqués sur le site public.
const secondaryLinks = [
  contact.email.value && { label: contact.email.value, href: `mailto:${contact.email.value}`, external: false },
  contact.githubUrl.value && { label: 'GitHub', href: contact.githubUrl.value, external: true },
  contact.cvPdfPath.value && { label: 'Télécharger mon CV (PDF)', href: contact.cvPdfPath.value, external: false },
].filter(Boolean) as { label: string; href: string; external: boolean }[];
---

<section id="contact" class="scroll-mt-24 border-t border-white/[0.06] py-20 sm:py-28" aria-labelledby="contact-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="section-eyebrow">{t.sections.contactEyebrow}</p>
      <h2 id="contact-heading" class="section-heading mt-3">{t.sections.contactTitle}</h2>
      <p class="section-lead mt-4">{t.sections.contactLead}</p>

      {contact.internshipAvailability.value && (
        <p class="mt-4 text-sm text-text-secondary">
          <span class="text-text-primary">Disponibilité :</span> {contact.internshipAvailability.value}
        </p>
      )}
      {contact.mobility.value && (
        <p class="mt-1 text-sm text-text-secondary">
          <span class="text-text-primary">Mobilité :</span> {contact.mobility.value}
        </p>
      )}

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href={contact.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-accent-primary px-5 py-2.5 text-sm font-semibold text-bg-primary transition-colors hover:bg-accent-primary/90"
        >
          Me contacter sur LinkedIn <span aria-hidden="true">↗</span><span class="sr-only">(nouvel onglet)</span>
        </a>
        {secondaryLinks.map((link) => (
          <a
            href={link.href}
            class="text-link"
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            {...(link.href.endsWith('.pdf') ? { download: true } : {})}
          >
            {link.label}
            {link.external && <><span aria-hidden="true">↗</span><span class="sr-only">(nouvel onglet)</span></>}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
