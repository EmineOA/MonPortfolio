---
import { profileConfig } from '@/config/profile';
import { uiStrings, type Locale } from '@/config/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const t = uiStrings[locale];
const { homeSkills } = profileConfig;
---

<section id="competences" class="scroll-mt-24 border-t border-white/[0.06] py-20 sm:py-24" aria-labelledby="skills-heading">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
    <div class="lg:col-span-4">
      <p class="section-eyebrow">{t.sections.skillsEyebrow}</p>
      <h2 id="skills-heading" class="section-heading mt-3">{t.sections.skillsTitle}</h2>
      <p class="section-lead mt-4 text-sm">{t.sections.skillsLead}</p>
    </div>

    <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:col-span-8">
      {homeSkills.map((domain) => (
        <div>
          <h3 class="font-display text-lg font-semibold text-text-primary">{domain.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">{domain.items.join(' · ')}</p>
          <p class="mt-3 text-sm text-text-muted">
            {t.sections.skillsEvidence}{' '}
            {domain.evidence.map((ev, i) => (
              <>
                <a href={ev.href} class="text-accent-primary underline-offset-4 hover:underline">{ev.label}</a>
                {i < domain.evidence.length - 1 && ', '}
              </>
            ))}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
