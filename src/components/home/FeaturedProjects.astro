---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import { uiStrings, type Locale } from '@/config/i18n';

interface Props {
  featured: CollectionEntry<'projects'>[];
  locale?: Locale;
}

const { featured, locale = 'fr' } = Astro.props;
const t = uiStrings[locale];
---

<section id="projets" class="scroll-mt-24 py-16 sm:py-20" aria-labelledby="projects-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="section-eyebrow">{t.sections.projectsEyebrow}</p>
        <h2 id="projects-heading" class="section-heading mt-3">{t.sections.projectsTitle}</h2>
        <p class="section-lead mt-4">{t.sections.projectsLead}</p>
      </div>
      <a href="/projets/" class="text-link shrink-0">
        {t.sections.projectsAll} <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {featured.map((project) => <ProjectCard project={project} locale={locale} />)}
    </div>
  </div>
</section>
