---
import { profileConfig } from '@/config/profile';
import { uiStrings, type Locale } from '@/config/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const t = uiStrings[locale];
const { contact } = profileConfig;

const navItems = [
  { href: '/#projets', label: t.nav.projects },
  { href: '/#experience', label: t.nav.experience },
  { href: '/#parcours', label: t.nav.education },
  { href: '/#competences', label: t.nav.skills },
  { href: '/#contact', label: t.nav.contact },
];
---

<header class="sticky top-0 z-50 w-full border-b border-white/[0.06] bg-bg-primary/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a
      href={locale === 'en' ? '/en' : '/'}
      class="group flex items-center gap-2.5"
      aria-label="Emine AGATT — accueil"
    >
      <span
        class="flex h-8 w-8 items-center justify-center rounded-md border border-accent-primary/35 font-mono text-xs font-semibold text-accent-primary transition-colors group-hover:border-accent-primary"
        aria-hidden="true"
      >
        EA
      </span>
      <span class="font-display text-base font-semibold tracking-tight text-text-primary">Emine AGATT</span>
    </a>

    <nav aria-label="Navigation principale" class="hidden md:block">
      <ul class="flex items-center gap-7">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="text-sm text-text-secondary transition-colors hover:text-text-primary">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      {contact.githubUrl.value && (
        <a
          href={contact.githubUrl.value}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md p-2 text-text-secondary transition-colors hover:text-text-primary"
          aria-label="GitHub (nouvel onglet)"
        >
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a10.9 10.9 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
          </svg>
        </a>
      )}
      <a
        href={contact.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md p-2 text-text-secondary transition-colors hover:text-text-primary"
        aria-label="LinkedIn (nouvel onglet)"
      >
        <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Navigation mobile -->
  <nav aria-label="Navigation mobile" class="border-t border-white/[0.05] md:hidden">
    <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1 px-4 py-2.5">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="text-xs text-text-secondary transition-colors hover:text-text-primary">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
