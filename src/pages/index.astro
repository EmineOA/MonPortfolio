---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import FeaturedProjects from '@/components/home/FeaturedProjects.astro';
import ExperienceTimeline from '@/components/home/ExperienceTimeline.astro';
import SkillsMatrix from '@/components/home/SkillsMatrix.astro';
import ContactSection from '@/components/home/ContactSection.astro';

const projects = await getCollection('projects');
---

<BaseLayout>
  <Hero locale="fr" />
  <FeaturedProjects projects={projects} locale="fr" />
  <ExperienceTimeline locale="fr" />
  <SkillsMatrix locale="fr" />
  <ContactSection locale="fr" />
</BaseLayout>
